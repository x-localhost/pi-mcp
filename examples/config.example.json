{
  "piPath": "/usr/local/bin/node",
  "piArgs": ["/opt/pi-mcp/node_modules/@earendil-works/pi-coding-agent/dist/bundle/cli.js"],
  "stateDir": "/var/lib/pi-mcp/state",
  "allowedRoots": ["/home/corp-user/workspace"],
  "maxConcurrent": 2,
  "defaultTimeoutSeconds": 1800,
  "maxTimeoutSeconds": 7200,
  "defaultMaxTurns": 30,
  "provider": "corporate",
  "model": "corporate-model",
  "modelsFile": "./models.example.json",
  "allowedCommands": ["npm test", "git status --short"],
  "envAllowlist": ["CORP_LLM_API_KEY", "CORP_LLM_HEADER_API_KEY", "CORP_LLM_CLIENT_ID"],
  "network": {
    "httpProxyEnv": "CORP_HTTP_PROXY",
    "httpsProxyEnv": "CORP_HTTPS_PROXY",
    "noProxyEnv": "CORP_NO_PROXY",
    "caFile": "/etc/ssl/certs/company-root-ca.pem",
    "npmRegistry": "https://npm.example.invalid/"
  }
}
