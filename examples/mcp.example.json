{
  "mcpServers": {
    "pi": {
      "command": "node",
      "args": ["/opt/pi-mcp/src/server.mjs"],
      "env": {
        "PI_MCP_CONFIG": "/etc/pi-mcp/config.json",
        "CORP_HTTP_PROXY": "http://proxy.example.invalid:8080",
        "CORP_HTTPS_PROXY": "http://proxy.example.invalid:8080",
        "CORP_NO_PROXY": "localhost,127.0.0.1"
      }
    }
  }
}
