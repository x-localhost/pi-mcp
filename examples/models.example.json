{
  "providers": {
    "corporate": {
      "baseUrl": "https://llm-gateway.corp.internal/v1",
      "api": "openai-completions",
      "apiKey": "$CORP_LLM_API_KEY",
      "headers": {
        "X-API-Key": "$CORP_LLM_HEADER_API_KEY",
        "X-Client-Id": "$CORP_LLM_CLIENT_ID",
        "X-Project-Id": "project-${CORP_LLM_PROJECT_ID}"
      },
      "models": [
        {
          "id": "corporate-model",
          "name": "Corporate model",
          "contextWindow": 128000,
          "maxTokens": 8192,
          "headers": {
            "X-Model-Variant": "$CORP_LLM_MODEL_VARIANT"
          }
        }
      ]
    }
  }
}
