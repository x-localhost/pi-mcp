# Administrator-built immutable project image. Replace the npm-cache and
# project-tools directories with approved, reviewed inputs before building.
# Keep the final image digest pinned in PI_INTERNAL_IMAGE for both services.
FROM node:24.22.0-bookworm@sha256:14078204b6bb268c107ceff6d3c43f45a888105e5c2b18b14c32b3409d93a1b0

RUN apt-get update && apt-get install -y --no-install-recommends git ripgrep fd-find ca-certificates \
    && ln -s /usr/bin/fdfind /usr/local/bin/fd \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY package.json package-lock.json ./
COPY npm-cache/ /opt/npm-cache/
RUN npm ci --offline --ignore-scripts --omit=dev --cache=/opt/npm-cache
COPY src ./src
COPY internal-agent ./internal-agent
COPY project-tools/ /opt/project-tools/
RUN mkdir -p /workspace /var/lib/pi-mcp /var/lib/pi-mcp/home /run/pi-internal /etc/pi-internal \
    && touch /etc/pi-internal/config.json /etc/pi-internal/models.json /etc/pi-internal/gateway.json /etc/pi-internal/ca.pem \
    && chown -R 1000:1000 /workspace /var/lib/pi-mcp /run/pi-internal

ENV HOME=/var/lib/pi-mcp/home
USER 1000:1000
CMD ["node", "/app/internal-agent/agent-daemon.mjs"]
